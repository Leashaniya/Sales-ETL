# Copy this file to .env and fill in your own values:  cp .env.example .env
# .env is listed in .gitignore, so real credentials are never committed.

# ---------- PostgreSQL ----------
PGHOST=localhost
PGPORT=5432
PGDATABASE=retail_db
PGUSER=your_mac_username
PGPASSWORD=

# ---------- AWS (IAM user with the least-privilege policy in aws/iam_policy.json) ----------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
S3_BUCKET_NAME=
S3_PREFIX=retail-etl
